# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=the-holdout
PINECONE_NAMESPACE=case_01
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
# real = Anthropic API, fake = deterministic offline LLM
LLM_MODE=real
# pinecone | memory (memory = offline hashing embedder, for tests/dev)
VECTOR_BACKEND=pinecone
# memory | sqlite
CHECKPOINTER=memory
CHECKER_ENABLED=true
START_TURNS=30
MAX_WRONG_ACCUSATIONS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
